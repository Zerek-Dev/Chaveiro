{
  "name": "site-chaveiro",
  "version": "1.0.0",
  "description": "Site de chaveiro 24h — Next.js + Firebase",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "serve:firebase": "npx -y firebase-tools@latest emulators:start --only hosting,firestore,auth",
